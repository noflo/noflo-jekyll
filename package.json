{
  "name": "@noflo/jekyll",
  "description": "Reimplementation of the Jekyll static site generator as a flow-based program",
  "version": "2.0.0-alpha.1",
  "author": {
    "name": "Henri Bergius",
    "email": "henri.bergius@iki.fi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noflo/noflo-jekyll.git"
  },
  "license": "MIT",
  "dependencies": {
    "@noflo/assembly": "^2.0.0-alpha.9",
    "@noflo/assembly-utils": "^2.0.0-alpha.9",
    "@noflo/core": "^2.0.0-alpha.1",
    "@noflo/filesystem": "^2.0.0-alpha.1",
    "@noflo/graph": "^2.0.0-alpha.9",
    "@noflo/groups": "^2.0.0-alpha.1",
    "@noflo/liquid": "^2.0.0-alpha.3",
    "@noflo/markdown": "^2.0.0-alpha.1",
    "@noflo/noflo": "^2.0.0-alpha.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@noflo/fbp-protocol": "^2.0.0-alpha.7",
    "@noflo/fbp-spec-runner": "^2.0.0-alpha.6",
    "@noflo/loader-node": "^2.0.0-alpha.6",
    "@noflo/manifest": "^2.0.0-alpha.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "bin": {
    "noflo-jekyll": "./bin/noflo-jekyll.js"
  },
  "keywords": [
    "noflo",
    "jekyll",
    "static-site"
  ],
  "scripts": {
    "lint": "npx @biomejs/biome check --use-editorconfig=true components/ lib/ test/*.js",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write components/ lib/ test/*.js",
    "types": "tsc --noEmit -p tsconfig.json",
    "test": "npm run types && npm run lint && npm run test:node",
    "test:node": "node --test --test-force-exit test/*.test.js",
    "test:bun": "bun test test/*.test.js",
    "test:deno": "deno test --allow-all --no-check test/*.test.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "components/",
    "graphs/",
    "lib/",
    "bin/",
    "test/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
